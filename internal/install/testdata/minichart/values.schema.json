{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "license": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "secret": { "type": "string" }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "string" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "string" },
        "db": { "type": "integer" },
        "password": { "type": "string" }
      }
    },
    "temporal": {
      "type": "object",
      "properties": {
        "disabled": { "type": "boolean" },
        "deploy": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "llms": { "type": "object" },
        "authentication": { "type": "object" },
        "storageBuckets": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "s3proxy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
