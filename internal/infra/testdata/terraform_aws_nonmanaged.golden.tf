# Terraform for a customer-managed LlamaCloud install.
# Generated by `llamacloudctl terraform` for namespace "acme", region "us-west-2".
# Hand this to whoever owns your AWS account; apply with `terraform init && terraform apply`.
# It creates the S3 buckets the platform uses and an IRSA role granting the
# pods runtime access to them. Wire the role ARN output into your Helm values
# (annotate the platform service accounts with eks.amazonaws.com/role-arn) so
# the pods assume it.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-west-2"
}

variable "oidc_provider_arn" {
  description = "ARN of the EKS cluster's IAM OIDC provider (aws eks describe-cluster + iam list-open-id-connect-providers)."
  type        = string
}

variable "oidc_provider_url" {
  description = "Host portion of the OIDC issuer URL, e.g. oidc.eks.us-west-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE."
  type        = string
}

variable "k8s_namespace" {
  description = "Namespace the platform runs in. Every service account in it may assume the role (the platform annotates ~10 workload SAs with the same role ARN)."
  type        = string
  default     = "acme"
}

resource "aws_s3_bucket" "bucket_acme_docs" {
  bucket = "acme-docs"
}

resource "aws_s3_bucket" "bucket_acme_output" {
  bucket = "acme-output"
}

resource "aws_iam_policy" "llama_s3" {
  name        = "llamacloud-acme-s3"
  description = "Runtime S3 access for the LlamaCloud platform pods."
  policy      = jsonencode({
    "Statement": [
      {
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket",
          "s3:GetBucketLocation"
        ],
        "Effect": "Allow",
        "Resource": [
          "${aws_s3_bucket.bucket_acme_docs.arn}",
          "${aws_s3_bucket.bucket_acme_output.arn}",
          "${aws_s3_bucket.bucket_acme_docs.arn}/*",
          "${aws_s3_bucket.bucket_acme_output.arn}/*"
        ],
        "Sid": "LlamaCloudS3"
      }
    ],
    "Version": "2012-10-17"
  })
}

resource "aws_iam_role" "llama_irsa" {
  name = "llamacloud-acme-irsa"
  assume_role_policy = jsonencode({
    "Statement": [
      {
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "${var.oidc_provider_url}:aud": "sts.amazonaws.com"
          },
          "StringLike": {
            "${var.oidc_provider_url}:sub": "system:serviceaccount:${var.k8s_namespace}:*"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Federated": "${var.oidc_provider_arn}"
        }
      }
    ],
    "Version": "2012-10-17"
  })
}

resource "aws_iam_role_policy_attachment" "llama_s3" {
  role       = aws_iam_role.llama_irsa.name
  policy_arn = aws_iam_policy.llama_s3.arn
}

output "irsa_role_arn" {
  description = "Annotate the platform service account with eks.amazonaws.com/role-arn = this value."
  value       = aws_iam_role.llama_irsa.arn
}
